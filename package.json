{
  "name": "pcos-health-ledger",
  "private": true,
  "version": "0.1.0",
  "description": "PCOS health record sharing for patients, doctors and researchers: React frontend + Node API with a hash-chained audit ledger and a Claude-powered chatbot.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @pcos/server dev",
    "dev:web": "pnpm --filter @pcos/web dev",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @pcos/server build",
    "start": "pnpm --filter @pcos/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.5.2"
}
