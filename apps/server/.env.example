# Copy to apps/server/.env for local development.

PORT=8787
DATABASE_PATH=./data/pcos.db

# Browser origins allowed to call the API (comma-separated).
# For GitHub Pages use https://<user>.github.io
CORS_ORIGIN=http://localhost:5173

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_TTL=8h

# Seed demo accounts (password Demo1234!) into an empty database.
SEED_DEMO=true

# PCOS chatbot service (https://github.com/InnovHer-Competition/chat-bot).
# Run it with `uvicorn app.main:app --port 8000` and point this at it.
# Without it (or when it is unreachable) the built-in offline assistant answers.
CHATBOT_URL=http://localhost:8000
# Optional bearer token, if the chatbot service is deployed behind one.
CHATBOT_TOKEN=
# The chatbot runs a local LLM; replies can take a while.
CHATBOT_TIMEOUT_MS=120000
