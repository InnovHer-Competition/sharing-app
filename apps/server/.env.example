# Copy to apps/server/.env for local development.

PORT=8787
DATABASE_PATH=./data/pcos-ledger.db

# Browser origins allowed to call the API (comma-separated).
# For GitHub Pages use https://<user>.github.io
CORS_ORIGIN=http://localhost:5173

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_TTL=8h

# Seed demo accounts (password Demo1234!) into an empty database.
SEED_DEMO=true

# Chatbot. Without a key the server uses its built-in offline assistant.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=low

# Optional: blockchain / ZKP service that anchors ledger blocks.
LEDGER_SERVICE_URL=
LEDGER_SERVICE_TOKEN=
